#!/usr/bin/env python3
"""
RETIRED (2026-10-18) — do not start this forwarder. Kept for history only.

Why it existed: the OpenCode V1 config shape put the endpoint at a root-level
`providers.ollama.baseURL`, which OpenCode V2 silently IGNORES. OpenCode then
fell back to probing the default `127.0.0.1:11434` inside WSL, so this shim
forwarded that port to the Windows host.

Why it is retired: OpenCode V2 reads `providers.ollama.settings.baseURL` and
connects to the Windows host directly — nothing should listen on
127.0.0.1:11434. Worse, pipe() below shuts down and closes BOTH sockets when
EITHER direction ends, so every completed response reset the client
connection; the next prompt died with ECONNRESET ("works after one prompt,
then times out"). wsl-ollama-bootfix.sh now kills any running copy.

Original purpose: forward TCP connections from 127.0.0.1:11434 to the Windows
host's Ollama (<wsl-host-ip>:11434) so OpenCode could reach local models.
"""
import socket
import threading
import sys
import os

LISTEN_HOST = "127.0.0.1"
LISTEN_PORT = 11434
TARGET_HOST = os.environ.get("OLLAMA_FORWARD_TARGET", "172.28.192.1")
TARGET_PORT = 11434


def pipe(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except (OSError, ConnectionError):
        pass
    finally:
        try:
            src.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        src.close()
        try:
            dst.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        dst.close()


def handle(client):
    try:
        target = socket.create_connection((TARGET_HOST, TARGET_PORT), timeout=5)
    except OSError:
        client.close()
        return
    threading.Thread(target=pipe, args=(client, target), daemon=True).start()
    threading.Thread(target=pipe, args=(target, client), daemon=True).start()


def main():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        server.bind((LISTEN_HOST, LISTEN_PORT))
    except OSError:
        # Port already in use — forwarder already running.
        sys.exit(0)
    server.listen(128)
    while True:
        client, _ = server.accept()
        threading.Thread(target=handle, args=(client,), daemon=True).start()


if __name__ == "__main__":
    main()
